{
  "name": "ads-scraw",
  "version": "1.0.0",
  "description": "广告数据查询平台 - React + Node.js",
  "main": "server/app.js",
  "type": "module",
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "antd": "^6.2.2",
    "chrome-finder": "^1.0.7",
    "chrome-launcher": "^1.0.0",
    "cors": "^2.8.5",
    "cross-env": "^5.2.0",
    "dayjs": "^1.11.9",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "flag-icon-css": "^4.1.7",
    "puppeteer": "^23.1.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "readline": "^1.3.0",
    "recharts": "^3.7.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cross-env NODE_ENV=development nodemon --ignore \"tmp/**\" --ignore \"dist/**\" server/app.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production node server/app.js",
    "start:prod": "npm run build && cross-env NODE_ENV=production node server/app.js",
    "postinstall": "node scripts/download-ffmpeg-core.js"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "nodemon": "^2.0.15",
    "vite": "^5.0.8"
  }
}
