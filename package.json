{
  "name": "gp-order",
  "version": "1.0.0",
  "description": "gp order",
  "main": "app.js",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.5",
    "puppeteer": "^23.1.0",
    "readline": "^1.3.0",
    "log4js": "^6.9.1",
    "dotenv": "^16.0.3"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "mocha tests --recursive --timeout 5000",
    "test-single": "mocha",
    "shell": "node --experimental-repl-await ./shell.js",
    "generate-docs": "jsdoc --configure .jsdoc.json --verbose",
    "aics-docs": "node build/aicsDocs.js",
    "start-docs": "live-server ./aicsDocs/", "node-fetch": "^3.3.0",
    "start-quick": "cross-env QUICK=true node app.js",
    "update-ws": "git pull https://github.com/pedroslopez/whatsapp-web.js.git main"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.15"
